{
  "description": "Discord communication platform",
  "arch": [
    "sudo pacman -Syu --noconfirm discord"
  ],
  "cachyos": [
    "sudo pacman -Syu --noconfirm discord"
  ],
  "debian": [
    "wget --content-disposition https://discord.com/api/download?platform=linux&format=deb",
    "sudo apt install -y ./*.deb",
    "rm ./*.deb"
  ],
  "ubuntu": [
    "wget --content-disposition https://discord.com/api/download?platform=linux&format=deb",
    "sudo apt install -y ./*.deb",
    "rm ./*.deb"
  ],
  "raspberrypi": [
    "wget --content-disposition https://discord.com/api/download?platform=linux&format=deb",
    "sudo apt install -y ./*.deb",
    "rm ./*.deb"
  ]
}
