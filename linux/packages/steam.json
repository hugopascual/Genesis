{
  "description": "Video game digital distribution service",
  "arch": [
    "sudo sed -i '/^#\\[multilib\\]/,/^\\s*$/ s/^#//' /etc/pacman.conf",
    "sudo pacman -Syu --noconfirm steam"
  ],
  "cachyos": [
    "sudo pacman -Syu --noconfirm cachyos-gaming-meta",
    "sudo pacman -Syu --noconfirm cachyos-gaming-applications"
  ],
  "debian": [
    "wget --content-disposition https://cdn.akamai.steamstatic.com/client/installer/steam.deb",
    "sudo apt install -y ./*.deb",
    "rm ./*.deb"
  ],
  "ubuntu": [
    "wget --content-disposition https://cdn.akamai.steamstatic.com/client/installer/steam.deb",
    "sudo apt install -y ./*.deb",
    "rm ./*.deb"
  ],
  "raspberrypi": [
    "wget --content-disposition https://cdn.akamai.steamstatic.com/client/installer/steam.deb",
    "sudo apt install -y ./*.deb",
    "rm ./*.deb"
  ]
}
