{
  "description": "Lutris: Open gaming platform",
  "arch": [
    "sudo pacman -Syu --noconfirm lutris"
  ],
  "cachyos": [
    "sudo pacman -Syu --noconfirm cachyos-gaming-meta",
    "sudo pacman -Syu --noconfirm cachyos-gaming-applications"
  ],
  "debian": [
    "sudo flatpak install flathub --user -y net.lutris.Lutris"
  ],
  "ubuntu": [
    "sudo flatpak install flathub --user -y net.lutris.Lutris"
  ],
  "raspberrypi": [
    "sudo flatpak install flathub --user -y net.lutris.Lutris"
  ]
}
