{
  "description": "Spanish digital signature tool",
  "arch": [
    "yay -Syu --noconfirm autofirma-bin"
  ],
  "ubuntu": [
    "curl -OL https://firmaelectronica.gob.es/content/dam/firmaelectronica/descargas-software/autofirma19/Autofirma_Linux_Debian.zip",
    "unzip Autofirma_Linux_Debian.zip",
    "sudo apt install -y ./*.deb",
    "rm Autofirma*"
  ],
  "debian": [
    "curl -OL https://firmaelectronica.gob.es/content/dam/firmaelectronica/descargas-software/autofirma19/Autofirma_Linux_Debian.zip",
    "unzip Autofirma_Linux_Debian.zip",
    "sudo apt install -y ./*.deb",
    "rm Autofirma*"
  ],
  "raspberrypi": [
    "curl -OL https://firmaelectronica.gob.es/content/dam/firmaelectronica/descargas-software/autofirma19/Autofirma_Linux_Debian.zip",
    "unzip Autofirma_Linux_Debian.zip",
    "sudo apt install -y ./*.deb",
    "rm Autofirma*"
  ],
  "cachyos": [
    "sudo pacman -Syu --noconfirm autofirma"
  ]
