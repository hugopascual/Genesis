{
  "description": "Fast system information tool",
  "arch": [
    "sudo pacman -Syu --noconfirm fastfetch"
  ],
  "ubuntu": [
    "wget --content-disposition https://github.com/fastfetch-cli/fastfetch/releases/download/2.63.1/fastfetch-linux-amd64.deb",
    "sudo apt-get install -y ./*.deb",
    "rm ./*.deb"
  ],
  "debian": [
    "wget --content-disposition https://github.com/fastfetch-cli/fastfetch/releases/download/2.63.1/fastfetch-linux-amd64.deb",
    "sudo apt-get install -y ./*.deb",
    "rm ./*.deb"
  ],
  "raspberrypi": [
    "wget --content-disposition https://github.com/fastfetch-cli/fastfetch/releases/download/2.63.1/fastfetch-linux-aarch64.deb",
    "sudo apt-get install -y ./*.deb",
    "rm ./*.deb"
  ]
}
