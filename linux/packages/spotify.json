{
  "description": "Spotify music streaming client",
  "arch": [
    "sudo pacman -Syu --noconfirm spotify-launcher"
  ],
  "ubuntu": [
    "curl -sS https://download.spotify.com/debian/pubkey_C85668DF69375001.gpg | gpg --dearmor --yes -o /etc/apt/trusted.gpg.d/spotify.gpg",
    "echo \"deb https://repository.spotify.com stable non-free\" | sudo tee /etc/apt/sources.list.d/spotify.list",
    "sudo apt-get update",
    "sudo apt-get install -y spotify-client"
  ],
  "debian": [
    "curl -sS https://download.spotify.com/debian/pubkey_C85668DF69375001.gpg | gpg --dearmor --yes -o /etc/apt/trusted.gpg.d/spotify.gpg",
    "echo \"deb https://repository.spotify.com stable non-free\" | sudo tee /etc/apt/sources.list.d/spotify.list",
    "sudo apt-get update",
    "sudo apt-get install -y spotify-client"
  ],
  "raspberrypi": [
    "curl -sS https://download.spotify.com/debian/pubkey_C85668DF69375001.gpg | gpg --dearmor --yes -o /etc/apt/trusted.gpg.d/spotify.gpg",
    "echo \"deb https://repository.spotify.com stable non-free\" | sudo tee /etc/apt/sources.list.d/spotify.list",
