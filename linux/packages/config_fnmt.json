{
  "description": "FNMT certificate configuration tool",
  "arch": [
    "yay -Syu --noconfirm configuradorfnmt"
  ],
  "ubuntu": [
    "wget https://descargas.cert.fnmt.es/Linux/configuradorfnmt_4.0.5_amd64.deb",
    "sudo apt install -y ./configuradorfnmt*",
    "rm configuradorfnmt*"
  ],
  "debian": [
    "wget https://descargas.cert.fnmt.es/Linux/configuradorfnmt_4.0.5_amd64.deb",
    "sudo apt install -y ./configuradorfnmt*",
    "rm configuradorfnmt*"
  ],
  "raspberrypi": [
    "wget https://descargas.cert.fnmt.es/Linux/configuradorfnmt_4.0.5_amd64.deb",
    "sudo apt install -y ./configuradorfnmt*",
    "rm configuradorfnmt*"
  ],
  "cachyos": [
    "sudo pacman -Syu --noconfirm config_fnmt"
  ]
}
