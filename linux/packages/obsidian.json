{
  "description": "Knowledge base and note-taking app",
  "arch": [
    "sudo pacman -Syu --noconfirm obsidian"
  ],
  "ubuntu": [
    "wget --content-disposition https://github.com/obsidianmd/obsidian-releases/releases/download/v1.6.7/obsidian_1.6.7_amd64.deb",
    "sudo apt-get install -y ./*.deb",
    "rm ./*.deb"
  ],
  "debian": [
    "wget --content-disposition https://github.com/obsidianmd/obsidian-releases/releases/download/v1.6.7/obsidian_1.6.7_amd64.deb",
    "sudo apt-get install -y ./*.deb",
    "rm ./*.deb"
  ]
}
