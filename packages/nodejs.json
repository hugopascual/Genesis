{
  "$schema": "../schema/package.schema.json",
  "description": "JavaScript runtime",
  "install": {
    "arch": {
      "commands": [
        "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash",
        "\\. $HOME/.nvm/nvm.sh",
        "nvm install 24"
      ]
    },
