{
  "$schema": "../schema/package.schema.json",
  "description": "Calibre ebook management",
  "install": {
    "arch": {
      "commands": [
        "sudo -v && wget -nv -O- https://download.calibre-ebook.com/linux-installer.sh | sudo sh /dev/stdin"
      ]
    },
    "cachyos": {
      "commands": [
        "sudo -v && wget -nv -O- https://download.calibre-ebook.com/linux-installer.sh | sudo sh /dev/stdin"
      ]
