{
  "$schema": "../schema/package.schema.json",
  "description": "Lutris: Open gaming platform",
  "install": {
    "arch": {
      "pacman": "lutris"
    },
    "cachyos": {
      "pacman": [
        "cachyos-gaming-meta",
        "cachyos-gaming-applications",
        "python-protobuf"
      ]
    },
    "debian": {
      "commands": [
        "sudo flatpak install flathub --user -y net.lutris.Lutris"
      ]
    },
    "ubuntu": {
      "commands": [
        "sudo flatpak install flathub --user -y net.lutris.Lutris"
      ]
    },
    "raspberrypi": {
      "commands": [
        "sudo flatpak install flathub --user -y net.lutris.Lutris"
      ]
    }
  }
}
